<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RBSoftSkkm</RootNamespace>

    <!-- AnyCPU вместо x86 — вместе с двойной регистрацией (Framework + Framework64)
         из reg.bat работает из любого хоста, независимо от его разрядности. -->
    <PlatformTarget>AnyCPU</PlatformTarget>

    <IsPackable>true</IsPackable>
    <PackageId>SkkmConnector</PackageId>
    <Version>1.27.0</Version>
    <Authors>rbsoft</Authors>
    <Company>rbsoft</Company>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Строгое имя — обязательно для установки в GAC. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>utils\key.snk</AssemblyOriginatorKeyFile>

    <!-- Binding redirects обязательны — System.Text.Json тянет цепочку зависимостей,
         без redirect'ов активация через COM падает в статическом конструкторе. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Вспомогательные файлы лежат в utils\ (исходники), но при сборке кладутся
         плоско в output-папку рядом с reg.bat/unreg.bat — тем же путём, каким их
         ожидает найти reg.bat через "%~dp0...". -->
    <None Include="utils\gacutil.exe" Link="gacutil.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="utils\gacutlrc.dll" Link="gacutlrc.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="utils\gacutil.exe.config" Link="gacutil.exe.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="utils\reg.bat" Link="reg.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="utils\reg_x86.bat" Link="reg_x86.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="utils\unreg.bat" Link="unreg.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="utils\policy.8.0.System.Text.Json.dll" Link="policy.8.0.System.Text.Json.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- policy-сборка ссылается в манифесте на свой .config: без него gacutil /i падает
         с "Один из указанных в манифесте модулей не найден". -->
    <None Include="utils\policy.8.0.System.Text.Json.config" Link="policy.8.0.System.Text.Json.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="utils\fix-binding-redirects.ps1" Link="fix-binding-redirects.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="utils\InstallReadme.md" Link="InstallReadme.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
